// Cloudflare Workers Builds: builds the frontend and serves it as static assets.
// The FastAPI backend runs on localhost and is exposed with a Cloudflare Tunnel;
// set VITE_API_URL (the tunnel's https URL) as a build variable in the dashboard.
{
  "name": "mockwright",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm ci && npm run build",
    "cwd": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
