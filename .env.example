# Copy to .env and fill in. Never commit .env.

# Leave blank to use a local SQLite file (mockwright.db in the repo root).
# For Postgres: postgresql+psycopg://USER:PASSWORD@localhost:5432/mockwright
DATABASE_URL=

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# How long a login lasts, in minutes (default 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini writes the adaptive interview questions and scores the feedback.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Deepgram transcribes spoken answers and reads questions aloud.
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Comma-separated browser origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
